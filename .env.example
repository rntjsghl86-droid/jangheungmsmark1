# Public school name shown in the UI. Safe to set in Vercel project settings.
NEXT_PUBLIC_SCHOOL_NAME=우리학교

# Shared PIN for teachers. Set this as a secret in Vercel project settings.
SCHOOL_PIN=change-me

# Administrator-only PIN: 4-12 digits, must differ from SCHOOL_PIN.
# Configure actual values in Vercel only after deployment approval.
ADMIN_PIN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
